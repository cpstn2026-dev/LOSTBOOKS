@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password — Lost Books Cebu</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/polish.css" asp-append-version="true" />
    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        .login-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #1f5c3f 0%, #2e8b57 50%, #4caf7d 100%);
            padding: 20px;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.25);
            padding: 40px 32px;
        }
    </style>
</head>
<body>
    <div class="login-page">
        <div class="login-card">

            <div class="text-center mb-4">
                <h4 class="fw-bold text-success mb-0">Forgot Password</h4>
                <p class="text-muted mb-0">Enter your registered email to receive a reset link.</p>
            </div>

            @if (ViewBag.RequestSubmitted == true)
            {
                <div class="alert alert-success">
                    If that email is registered, a reset link has been sent. Please check your inbox.
                </div>
            }
            else
            {
                <form asp-controller="Login" asp-action="ForgotPassword" method="post">
                    <div class="mb-4">
                        <label class="form-label fw-bold">Email Address</label>
                        <input type="email" name="email" class="form-control" required autofocus />
                    </div>
                    <button type="submit" class="btn btn-success w-100 py-2 fw-bold">
                        Send Reset Link
                    </button>
                </form>
            }

            <p class="text-center mt-3 mb-0">
                <a asp-controller="Login" asp-action="Index" class="text-success">Back to Login</a>
            </p>

        </div>
    </div>
</body>
</html>