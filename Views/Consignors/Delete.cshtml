@model LOSTBOOKS.Models.Consignor

@{
    ViewData["Title"] = "Delete";
}

<div style="font-family: sans-serif; padding: 20px; max-width: 800px; margin: 0 auto;">

    <h3>Are you sure you want to delete this?</h3>
    <h4>Consigner</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Consigner Name</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ConsignorName)</dd>

        <dt class="col-sm-3">Contact Number</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ContactNumber)</dd>

        <dt class="col-sm-3">Email Address</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.EmailAddress)</dd>

        <dt class="col-sm-3">Home Address</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.HomeAddress)</dd>

        <dt class="col-sm-3">GCash Number</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.GcashNumber)</dd>

        <dt class="col-sm-3">Bank Account</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.BankName)</dd>

        <dt class="col-sm-3">Bank Account Number</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.BankAccountNumber)</dd>

        <dt class="col-sm-3">Account Name</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.AccountName)</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="ConsignorID" />

        <div style="text-align: center; margin-top: 40px;">
            <input type="submit" value="remove" style="background-color: red; color: white; border: none; padding: 8px 20px; font-size: 16px; cursor: pointer; margin-right: 15px;" class="btn btn-danger" />
            <a asp-action="Index" style="background-color: blue; color: white; border: none; padding: 8px 20px; font-size: 16px; text-decoration: none; display: inline-block;">cancel</a>
        </div>
    </form>
</div>
