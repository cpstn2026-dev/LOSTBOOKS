@model IEnumerable<LOSTBOOKS.Models.Product>

@{
    ViewData["Title"] = "Index";
}

<h1>Product Management</h1><br />



<form asp-action="Create" method="post">
    <p>
        Name: <input type="text" name="ProductName" required />
    </p>
    <p>
        Category:
        <select name="Category" required>
            <option value="">-- Select --</option>
            <option value="Coffee">Coffee</option>
            <option value="Pastries">Pastries</option>  
            <option value="Beverage">Beverage</option>
            <option value="Snack">Snack</option>
        </select>
    </p>
  
    <p>
        

           Selling Price: <input type="number" step="0.01" name="SellingPrice" required />

    </p>
    <button type="submit" style="background-color: blue; color: white; border: none; padding: 5px 15px; cursor: pointer;">ADD</button>

</form>
<br />


<hr />
<br />

<form asp-action="Index" method="get">
    <input type="text" name="searchString" placeholder="Search products..." />
    <button type="submit">Search</button>
</form>

<table border="1" cellpadding="10" style="width:100%; border-collapse: collapse;">
    <thead>
        <tr style="background-color: #f2f2f2;">
            <th>ID</th>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Actions</th>
           
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductID</td>
                <td>@item.ProductName</td>
                <td>@item.Category</td>
                <td>₱@item.SellingPrice</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ProductID" button type="submit" style="background-color: green ;color: white; border: none; padding: 5px 15px;">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.ProductID" button type="submit" style="background-color: red ;color: white; border: none; padding: 5px 15px;">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
