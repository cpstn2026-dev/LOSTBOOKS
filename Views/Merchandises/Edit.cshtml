@model LOSTBOOKS.Models.Merchandise

@{
    ViewData["Title"] = "Edit";
}

<h1>Merchandise Management</h1>
<br />

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="MerchandiseID" />

    <p>
        Merchandise ID:
        MER-@Model.MerchandiseID.ToString("D4")
    </p>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- NAME -->
    <div style="display:flex; align-items:center; gap:15px; margin-bottom:20px;">
        <label style="font-size:15px;">Name:</label>
        <input asp-for="MerchandiseName" required />
        <span asp-validation-for="MerchandiseName" style="color:red;"></span>
    </div>

    <!-- CATEGORY -->
    <div style="display:flex; align-items:center; gap:15px; margin-bottom:20px;">
        <label style="font-size:15px;">Category:</label>
        <input asp-for="Category" required />
        <span asp-validation-for="Category" style="color:red;"></span>
    </div>

    <!-- QUANTITY -->
    <div style="display:flex; align-items:center; gap:15px; margin-bottom:20px;">
        <label style="font-size:15px;">Quantity:</label>
        <input asp-for="Quantity" type="number" min="0" required />
        <span asp-validation-for="Quantity" style="color:red;"></span>
    </div>

    <!-- PRICE -->
    <div style="display:flex; align-items:center; gap:15px; margin-bottom:20px;">
        <label style="font-size:15px;">Selling Price:</label>
        <input asp-for="SellingPrice" type="number" step="0.01" required />
        <span asp-validation-for="SellingPrice" style="color:red;"></span>
    </div>

    <!-- STORE SHARE -->
    <div style="display:flex; align-items:center; gap:15px; margin-bottom:20px;">
        <label style="font-size:15px;">Store Share %:</label>
        <input asp-for="StoreSharePercentage" type="number" step="0.01" required />
        <span asp-validation-for="StoreSharePercentage" style="color:red;"></span>
    </div>

    <div style="display:flex; align-items:center; gap:15px; margin-bottom:35px;">
        <label>Consignor ID:</label>

        <input value="CON-@Model.ConsignorID.ToString("D4")"
               class="form-control"
               readonly />

       
        <input type="hidden" asp-for="ConsignorID" />

        <span asp-validation-for="ConsignorID" style="color:red;"></span>
    </div>

    <!-- BUTTONS -->
    <div style="text-align: right;">
        <button type="submit"
                style="background-color: green; color: white; border: none; padding: 5px 15px; cursor: pointer;">
            update
        </button>

        <a asp-action="Index"
           style="background-color: blue; color: white; border: none; padding: 8px 15px; text-decoration: none;">
            cancel
        </a>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}