@model LOSTBOOKS.Models.Product

@{
    ViewData["Title"] = "Delete";
}

<div style="font-family: sans-serif; padding: 20px; max-width: 800px; margin: 0 auto;">

    
    <h3>Are you sure you want to delete this?</h3>
    <h4>Product</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Product Name</dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.ProductName)
        </dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Category)
        </dd>

        <dt class="col-sm-3">Selling Price</dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.SellingPrice)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ProductID" />

        <div style="text-align: center; margin-top: 40px;">
            <input type="submit"
                   value="remove"
                   style="background-color: red; color: white; border: none; padding: 8px 20px; font-size: 16px; cursor: pointer; margin-right: 15px;" />

            <a asp-action="Index"
               style="background-color: blue; color: white; border: none; padding: 8px 20px; font-size: 16px; text-decoration: none; display: inline-block;">
                cancel
            </a>
        </div>
    </form>
    

</div>
