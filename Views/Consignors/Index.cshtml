@model IEnumerable<LOSTBOOKS.Models.Consignor>

@{
    ViewData["Title"] = "Index";
    bool showInactive = ViewBag.ShowInactive ?? false;
}
<h1>Consignor Management</h1>
<br />

<form asp-action="Create" method="post">
    <p>
        Consignor Name:
        <input type="text" name="ConsignorName" required />
    </p>
    <p>
        Contact Number: <input type="number" name="ContactNumber" pattern="[0-9]*" inputmode="numeric" title="Please enter numbers only" maxlength="11" required />
    </p>
    <p>
        Email Address:
        <input type="email" name="EmailAddress" required />
    </p>

    <button type="submit" style="background-color: blue; color: white; padding: 5px 15px;">
        ADD
    </button>
</form>
<br />

<hr />
<br />

<form asp-action="Index" method="get" style="margin-bottom: 20px;">
    <input type="text" name="searchString" placeholder="Search consignors..." value="@Context.Request.Query["searchString"]" />
    <button type="submit">Search</button>

    <label style="margin-left:20px;">
        <input type="checkbox" name="showInactive" value="true" onchange="this.form.submit()" checked="@showInactive" />
        Show deactivated consignors
    </label>
</form>

<table border="1" cellpadding="10" style="width:100%; border-collapse: collapse;">
    <thead>
        <tr style="background-color: #f2f2f2;">
            <th>ID</th>
            <th>Name</th>
            <th>Contact Number</th>
            <th>Email Address</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>CON-@item.ConsignorID.ToString("D4")</td>
                <td>@item.ConsignorName</td>
                <td>@item.ContactNumber</td>
                <td>@item.EmailAddress</td>
                <td>
                    @if (item.IsActive)
                    {
                        <span style="color:green; font-weight:bold;">Active</span>
                    }
                    else
                    {
                        <span style="color:gray; font-weight:bold;">Deactivated</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ConsignorID" style="background-color: green; color: white; border: none; padding: 5px 15px; text-decoration: none; display: inline-block;">Edit</a>

                    @if (item.IsActive)
                    {
                        <a asp-action="Deactivate" asp-route-id="@item.ConsignorID" style="background-color: red; color: white; border: none; padding: 5px 15px; text-decoration: none; display: inline-block;">Deactivate</a>
                    }
                    else
                    {
                        <form asp-action="Reactivate" asp-route-id="@item.ConsignorID" method="post" style="display:inline;">
                            <button type="submit" style="background-color: #28a745; color: white; border: none; padding: 5px 15px;">Reactivate</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
