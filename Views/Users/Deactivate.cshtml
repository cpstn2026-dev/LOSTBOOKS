@model LOSTBOOKS.Models.User

@{
    ViewData["Title"] = "Confirm Deactivation";
}

<div class="container-fluid">

    <h2 class="fw-bold text-danger mb-4">
        <i class="bi bi-exclamation-triangle"></i>
        Deactivate User
    </h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <p>Are you sure you want to deactivate this account?</p>

            <ul>
                <li><strong>Full Name:</strong> @Model.FullName</li>
                <li><strong>Username:</strong> @Model.Username</li>
                <li><strong>Role:</strong> @Model.Role</li>
            </ul>

            <form asp-controller="Users" asp-action="Deactivate" asp-route-id="@Model.UserID" method="post">
                <button type="submit" class="btn btn-danger">
                    Confirm
                </button>

                <a asp-controller="Users" asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>

        </div>
    </div>

</div>