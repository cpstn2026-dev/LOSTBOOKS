@model LOSTBOOKS.Models.Consignor

@{
    ViewData["Title"] = "Edit";
}

<h1>Consignor Management</h1>
<br />

<form asp-action="Edit" asp-route-id="@Model.ConsignorID" method="post">

   
    <input type="hidden" asp-for="ConsignorID" />

    <p>
        Consignor ID:
        CON-@Model.ConsignorID.ToString("D4")
    </p>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div style="display:flex; align-items:center; gap:15px; margin-bottom:20px;">
        <label style="font-size:15px;">Name:</label>
        <input asp-for="ConsignorName" required />
        <span asp-validation-for="ConsignorName" style="color:red; font-size:13px;"></span>
    </div>

    <div style="display:flex; align-items:center; gap:15px; margin-bottom:20px;">
        <label style="font-size:15px;">Contact Number:</label>
        <input asp-for="ContactNumber"
               pattern="[0-9]*"
               maxlength="11"
               inputmode="numeric"
               required />
        <span asp-validation-for="ContactNumber" style="color:red; font-size:13px;"></span>
    </div>

    <div style="display:flex; align-items:center; gap:15px; margin-bottom:20px;">
        <label style="font-size:15px;">Email Address:</label>
        <input asp-for="EmailAddress" type="email" required />
        <span asp-validation-for="EmailAddress" style="color:red; font-size:13px;"></span>
    </div>

    <div style="display:flex; align-items:center; gap:15px; margin-bottom:20px;">
        <label style="font-size:15px;">Home Address:</label>
        <input asp-for="HomeAddress" style="width:400px;" required />
        <span asp-validation-for="HomeAddress" style="color:red; font-size:13px;"></span>
    </div>

    <div style="display:flex; align-items:center; gap:15px; margin-bottom:20px;">
        <label style="font-size:15px;">GCash Number:</label>
        <input asp-for="GcashNumber"
               pattern="[0-9]*"
               maxlength="11"
               inputmode="numeric"
               required />
        <span asp-validation-for="GcashNumber" style="color:red; font-size:13px;"></span>
    </div>

    <div style="display:flex; align-items:center; gap:15px; margin-bottom:20px;">
        <label style="font-size:15px;">Bank Name:</label>
        <input asp-for="BankName" />
        <span asp-validation-for="BankName" style="color:red; font-size:13px;"></span>
    </div>

    <div style="display:flex; align-items:center; gap:15px; margin-bottom:20px;">
        <label style="font-size:15px;">Bank Account Number:</label>
        <input asp-for="BankAccountNumber" />
        <span asp-validation-for="BankAccountNumber" style="color:red; font-size:13px;"></span>
    </div>

    <div style="display:flex; align-items:center; gap:15px; margin-bottom:35px;">
        <label style="font-size:15px;">Account Name:</label>
        <input asp-for="AccountName" />
        <span asp-validation-for="AccountName" style="color:red; font-size:13px;"></span>
    </div>

    <div style="text-align:right;">
        <button type="submit"
                style="background-color:green; color:white; border:none; padding:5px 15px; cursor:pointer;">
            update
        </button>

        <a asp-action="Index"
           style="background-color:blue; color:white; padding:8px 15px; text-decoration:none;">
            cancel
        </a>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}