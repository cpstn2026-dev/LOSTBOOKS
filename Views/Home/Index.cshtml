@model List<LOSTBOOKS.ViewModels.POSViewModels>

@{
    ViewData["Title"] = "PAGE & POUR POS";
}

<div class="container-fluid py-4">

    <!-- =========================
         PAGE & POUR POS HEADER
    ========================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="text-success fw-bold mb-0">
            PAGE & POUR POS
        </h2>

        <button type="button"
                class="btn btn-dark position-relative px-4"
                data-bs-toggle="offcanvas"
                data-bs-target="#shoppingBag">

            🛒 Shopping Bag

            <span id="cartBadge"
                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">

                0

            </span>

        </button>

    </div>


    <!-- =========================
         SEARCH AND CATEGORY
    ========================== -->

    <form asp-action="Index"
          method="get"
          class="mb-4">

        <div class="row g-3 align-items-end">

            <!-- Search -->
            <div class="col-md-5">

                <label class="form-label fw-bold">
                    Search Item
                </label>

                <input type="text"
                       class="form-control"
                       name="search"
                       placeholder="Search Item..."
                       value="@Context.Request.Query["search"]" />

            </div>


            <!-- Search Button -->
            <div class="col-md-2">

                <button type="submit"
                        class="btn btn-success w-100">

                    🔍 Search

                </button>

            </div>


            <!-- Category -->
            <div class="col-md-3">

                <label class="form-label fw-bold">
                    Category
                </label>

                <select class="form-select"
                        name="category">

                    <option value="All"
                            selected="@(Context.Request.Query["category"] == "All" || string.IsNullOrEmpty(Context.Request.Query["category"]))">

                        All Categories

                    </option>

                    <option value="Books"
                            selected="@(Context.Request.Query["category"] == "Books")">

                        Books

                    </option>

                    <option value="Products"
                            selected="@(Context.Request.Query["category"] == "Products")">

                        Products

                    </option>

                    <option value="Merchandise"
                            selected="@(Context.Request.Query["category"] == "Merchandise")">

                        Merchandise

                    </option>

                    <option value="Services"
                            selected="@(Context.Request.Query["category"] == "Services")">

                        Services

                    </option>

                </select>

            </div>


            <!-- Filter -->
            <div class="col-md-2">

                <button type="submit"
                        class="btn btn-success w-100">

                    Filter

                </button>

            </div>

        </div>

    </form>


    <!-- =========================
         PRODUCT TABLE
    ========================== -->

    <div class="card shadow-sm">

        <div class="card-header bg-success text-white">

            <h5 class="mb-0">
                Available Items
            </h5>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-bordered table-hover mb-0">

                    <thead>

                        <tr>

                            <th>Item ID</th>

                            <th>Item Name</th>

                            <th>Category</th>

                            <th>Price</th>

                            <th>Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {

                            foreach (var item in Model)
                            {

                                <tr>

                                    <td>
                                        @item.Id
                                    </td>

                                    <td>
                                        @item.Name
                                    </td>

                                    <td>
                                        @item.Category
                                    </td>

                                    <td>
                                        ₱@item.Price.ToString("N2")
                                    </td>

                                    <td>

                                        <button type="button"
                                                class="btn btn-success btn-sm"
                                                data-id="@item.Id"
                                                data-name="@item.Name"
                                                data-price="@item.Price"
                                                data-stock="@item.Stock"
                                                data-category="@item.Category"
                                                data-bs-toggle="modal"
                                                data-bs-target="#cartModal">

                                            Add to Cart

                                        </button>

                                    </td>

                                </tr>

                            }

                        }
                        else
                        {

                            <tr>

                                <td colspan="5"
                                    class="text-center text-muted py-4">

                                    No items found.

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     ADD TO CART MODAL
========================================================= -->

<div class="modal fade"
     id="cartModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <!-- HEADER -->

            <div class="modal-header">

                <h4 class="modal-title">
                    Add To Cart
                </h4>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- BODY -->

            <div class="modal-body">

                <!-- ITEM NAME -->

                <div class="mb-3">

                    <label class="form-label">
                        Item Name
                    </label>

                    <input id="itemName"
                           class="form-control"
                           readonly />

                </div>


                <!-- PRICE -->

                <div class="mb-3">

                    <label class="form-label">
                        Price
                    </label>

                    <input id="itemPrice"
                           class="form-control"
                           readonly />

                </div>


                <!-- QUANTITY -->

                <div id="qtySection"
                     class="mb-3">

                    <label class="form-label">
                        Quantity
                    </label>

                    <div class="input-group">

                        <button type="button"
                                class="btn btn-secondary"
                                onclick="minusQty()">

                            −

                        </button>

                        <input id="qty"
                               type="number"
                               class="form-control text-center"
                               value="1"
                               min="1" />

                        <button type="button"
                                class="btn btn-secondary"
                                onclick="addQty()">

                            +

                        </button>

                    </div>

                </div>


                <!-- TOTAL -->

                <h5 class="fw-bold mt-4">

                    Total :
                    ₱<span id="totalPrice">0.00</span>

                </h5>

            </div>


            <!-- FOOTER -->

            <div class="modal-footer">

                <button id="btnAddCart"
                        type="button"
                        class="btn btn-success">

                    Add To Cart

                </button>

                <button type="button"
                        class="btn btn-danger"
                        data-bs-dismiss="modal">

                    Cancel

                </button>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     SHOPPING BAG
========================================================= -->

<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="shoppingBag"
     style="width: 520px;">

    <!-- HEADER -->

    <div class="offcanvas-header bg-success text-white">

        <h4 class="mb-0">

            🛒 Shopping Bag

        </h4>

        <button type="button"
                class="btn-close btn-close-white"
                data-bs-dismiss="offcanvas">
        </button>

    </div>


    <!-- BODY -->

    <div class="offcanvas-body">

        <!-- CART TABLE -->

        <div class="table-responsive">

            <table class="table table-bordered align-middle">

                <thead>

                    <tr>

                        <th>Item</th>

                        <th>Category</th>

                        <th>Qty</th>

                        <th>Unit Price</th>

                        <th>Subtotal</th>

                        <th>Action</th>

                    </tr>

                </thead>

                <tbody id="cartItems">

                    <tr>

                        <td colspan="6"
                            class="text-center text-muted py-4">

                            No items in cart.

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>


        <hr />


        <!-- TOTAL -->

        <div class="mb-3">

            <label class="form-label fw-bold">
                Total
            </label>

            <input id="cartTotal"
                   class="form-control form-control-lg"
                   value="0.00"
                   readonly />

        </div>


        <!-- PAYMENT TYPE -->

        <div class="mb-3">

            <label class="form-label fw-bold">
                Payment Type
            </label>

            <select id="paymentType"
                    class="form-select form-select-lg">

                <option value="Cash">
                    Cash
                </option>

                <option value="Digital Payment">
                    Digital Payment
                </option>

            </select>

        </div>


        <!-- =========================
             CASH
        ========================== -->

        <div id="cashSection">

            <div class="mb-3">

                <label class="form-label fw-bold">
                    Cash Received
                </label>

                <input id="cash"
                       type="number"
                       class="form-control form-control-lg"
                       value="0"
                       min="0" />

            </div>


            <div class="mb-3">

                <label class="form-label fw-bold">
                    Change
                </label>

                <input id="change"
                       class="form-control form-control-lg"
                       value="0.00"
                       readonly />

            </div>

        </div>


        <!-- =========================
             DIGITAL PAYMENT
        ========================== -->

        <div id="digitalSection"
             style="display:none;">

            <div class="mb-3">

                <label class="form-label fw-bold">
                    Digital Payment Method
                </label>

                <select id="paymentDetail"
                        class="form-select form-select-lg">

                    <option value="GCash">GCash</option>

                    <option value="Maya">Maya</option>

                    <option value="Bank Transfer">Bank Transfer</option>

                    <option value="QRPh">QR Ph</option>

                    <option value="Card">Card</option>

                    <option value="Other">Other</option>

                </select>

            </div>

            <div class="mb-3">

                <label class="form-label fw-bold">

                    Reference No.

                </label>

                <input id="referenceNo"
                       class="form-control form-control-lg"
                       placeholder="Enter Reference Number" />

            </div>

        </div>


        <!-- =========================
             BUTTONS
        ========================== -->

        <div class="d-grid gap-2">

            <button id="btnClear"
                    type="button"
                    class="btn btn-danger btn-lg">

                Clear Cart

            </button>


            <button id="btnCheckout"
                    type="button"
                    class="btn btn-success btn-lg">

                Checkout

            </button>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        // =========================================================
        // VARIABLES
        // =========================================================

        let price = 0;

        let stock = 0;

        let category = "";

        let cart = [];


        let selectedItem = {

            id: "",

            name: "",

            price: 0,

            stock: 0,

            category: ""

        };


        // =========================================================
        // MODAL
        // =========================================================

        const modal =
            document.getElementById("cartModal");


        modal.addEventListener(
            "show.bs.modal",
            function (event) {

                const button =
                    event.relatedTarget;


                // GET ITEM DATA

                selectedItem.id =
                    button.dataset.id;

                selectedItem.name =
                    button.dataset.name;

                selectedItem.price =
                    parseFloat(button.dataset.price) || 0;

                selectedItem.stock =
                    parseInt(button.dataset.stock) || 0;

                selectedItem.category =
                    button.dataset.category;


                // SET VARIABLES

                price =
                    selectedItem.price;

                stock =
                    selectedItem.stock;

                category =
                    selectedItem.category;


                // DISPLAY ITEM

                document.getElementById("itemName").value =
                    selectedItem.name;

                document.getElementById("itemPrice").value =
                    "₱" + selectedItem.price.toFixed(2);


                // RESET QUANTITY

                document.getElementById("qty").value = 1;


                // SERVICES DO NOT NEED QUANTITY

                if (category === "Services") {

                    document.getElementById("qtySection")
                        .style.display = "none";

                }
                else {

                    document.getElementById("qtySection")
                        .style.display = "block";

                }


                computeTotal();

            }
        );


        // =========================================================
        // ADD QUANTITY
        // =========================================================

        function addQty() {

            const qty =
                document.getElementById("qty");


            let currentQty =
                parseInt(qty.value) || 1;


            // PRODUCTS CAN HAVE MULTIPLE

            if (category === "Products") {

                currentQty++;

            }

            // BOOKS / MERCHANDISE

            else {

                if (currentQty < stock) {

                    currentQty++;

                }

            }


            qty.value =
                currentQty;


            computeTotal();

        }


        // =========================================================
        // MINUS QUANTITY
        // =========================================================

        function minusQty() {

            const qty =
                document.getElementById("qty");


            let currentQty =
                parseInt(qty.value) || 1;


            if (currentQty > 1) {

                currentQty--;

            }


            qty.value =
                currentQty;


            computeTotal();

        }


        // =========================================================
        // COMPUTE MODAL TOTAL
        // =========================================================

        function computeTotal() {

            let qty =
                parseInt(
                    document.getElementById("qty").value
                ) || 1;


            if (category === "Services") {

                qty = 1;

            }


            let total =
                price * qty;


            document.getElementById("totalPrice")
                .innerText =
                total.toFixed(2);

        }


        // =========================================================
        // ADD TO CART
        // =========================================================

        document
            .getElementById("btnAddCart")
            .addEventListener(
                "click",
                function () {

                    let qty;


                    if (category === "Services") {

                        qty = 1;

                    }
                    else {

                        qty =
                            parseInt(
                                document.getElementById("qty").value
                            ) || 1;

                    }


                    // FIND SAME ITEM
                    // IMPORTANT:
                    // SAME ITEM = SAME ID

                    let existing =
                        cart.find(
                            x => x.id === selectedItem.id
                        );


                    // IF ITEM ALREADY EXISTS
                    // INCREASE QUANTITY

                    if (existing) {

                        existing.qty += qty;

                    }

                    // OTHERWISE ADD NEW ITEM

                    else {

                        cart.push({

                            id:
                                selectedItem.id,

                            name:
                                selectedItem.name,

                            price:
                                selectedItem.price,

                            qty:
                                qty,

                            category:
                                selectedItem.category

                        });

                    }


                    loadCart();

                    updateBadge();


                    bootstrap.Modal
                        .getInstance(modal)
                        .hide();

                }
            );


        // =========================================================
        // LOAD SHOPPING BAG
        // =========================================================

        function loadCart() {

            let html = "";

            let total = 0;


            // EMPTY CART

            if (cart.length === 0) {

                html = `

                    <tr>

                        <td colspan="6"
                            class="text-center text-muted py-4">

                            No items in cart.

                        </td>

                    </tr>

                `;

            }

            // HAS ITEMS

            else {

                cart.forEach(
                    function (item, index) {

                        let subtotal =
                            item.price * item.qty;


                        total += subtotal;


                        html += `

                            <tr>

                                <td>
                                    ${item.name}
                                </td>

                                <td>
                                    ${item.category}
                                </td>

                                <td>

                                    <div class="d-flex
                                                align-items-center
                                                justify-content-center">

                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            onclick="decreaseQty(${index})">

                                            −

                                        </button>

                                        <span class="mx-2 fw-bold">

                                            ${item.qty}

                                        </span>

                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            onclick="increaseQty(${index})">

                                            +

                                        </button>

                                    </div>

                                </td>

                                <td>
                                    ₱${item.price.toFixed(2)}
                                </td>

                                <td class="fw-bold">

                                    ₱${subtotal.toFixed(2)}

                                </td>

                                <td class="text-center">

                                    <button
                                        type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        onclick="removeItem(${index})">

                                        🗑

                                    </button>

                                </td>

                            </tr>

                        `;

                    }
                );

            }


            document.getElementById("cartItems")
                .innerHTML = html;


            document.getElementById("cartTotal")
                .value =
                total.toFixed(2);


            computeChange();

        }


        // =========================================================
        // UPDATE BADGE
        // =========================================================
        //
        // IMPORTANT:
        //
        // cart.length = NUMBER OF DIFFERENT ITEMS
        //
        // Example:
        //
        // Noli x 2
        // Badge = 1
        //
        // Noli x 2 + Cupcake x 1
        // Badge = 2
        //
        // NOT 3
        //
        // =========================================================

        function updateBadge() {

            document.getElementById("cartBadge")
                .innerText =
                cart.length;

        }


        // =========================================================
        // REMOVE ITEM
        // =========================================================

        function removeItem(index) {

            cart.splice(index, 1);

            loadCart();

            updateBadge();

        }


        // =========================================================
        // INCREASE CART QUANTITY
        // =========================================================

        function increaseQty(index) {

            cart[index].qty++;

            loadCart();

            // DO NOT INCREASE BADGE
            // because it is still the same item

            updateBadge();

        }


        // =========================================================
        // DECREASE CART QUANTITY
        // =========================================================

        function decreaseQty(index) {

            if (cart[index].qty > 1) {

                cart[index].qty--;

            }
            else {

                cart.splice(index, 1);

            }


            loadCart();

            updateBadge();

        }


        // =========================================================
        // CLEAR CART
        // =========================================================

        document
            .getElementById("btnClear")
            .addEventListener(
                "click",
                function () {

                    if (cart.length === 0) {

                        return;

                    }


                    if (
                        !confirm(
                            "Clear all items from the shopping bag?"
                        )
                    ) {

                        return;

                    }


                    cart = [];


                    loadCart();

                    updateBadge();


                    // RESET CASH

                    document.getElementById("cash")
                        .value = 0;


                    document.getElementById("change")
                        .value = "0.00";


                    // RESET DIGITAL PAYMENT FIELDS

                    document.getElementById("referenceNo")
                        .value = "";

                }
            );


        // =========================================================
        // COMPUTE CHANGE
        // =========================================================

        function computeChange() {

            let total =
                parseFloat(
                    document.getElementById("cartTotal").value
                ) || 0;


            let cash =
                parseFloat(
                    document.getElementById("cash").value
                ) || 0;


            let change =
                cash - total;


            if (change < 0) {

                change = 0;

            }


            document.getElementById("change")
                .value =
                change.toFixed(2);

        }


        // =========================================================
        // CASH INPUT
        // =========================================================

        document
            .getElementById("cash")
            .addEventListener(
                "input",
                computeChange
            );


        // =========================================================
        // PAYMENT TYPE
        // =========================================================

        document
            .getElementById("paymentType")
            .addEventListener(
                "change",
                function () {

                    if (this.value === "Cash") {

                        document.getElementById(
                            "cashSection"
                        ).style.display = "block";


                        document.getElementById(
                            "digitalSection"
                        ).style.display = "none";


                        computeChange();

                    }
                    else {

                        document.getElementById(
                            "cashSection"
                        ).style.display = "none";


                        document.getElementById(
                            "digitalSection"
                        ).style.display = "block";

                    }

                }
            );


        // =========================================================
        // CHECKOUT
        // =========================================================

        document
            .getElementById("btnCheckout")
            .addEventListener(
                "click",
                async function () {

                    // CHECK EMPTY CART

                    if (cart.length === 0) {

                        alert(
                            "Shopping Bag is empty."
                        );

                        return;

                    }


                    // GET PAYMENT TYPE

                    let paymentType =
                        document.getElementById(
                            "paymentType"
                        ).value;


                    // TOTAL

                    let total =
                        parseFloat(
                            document.getElementById(
                                "cartTotal"
                            ).value
                        ) || 0;


                    let paymentDetail = "";


                    // =================================================
                    // CASH
                    // =================================================

                    if (paymentType === "Cash") {

                        let cash =
                            parseFloat(
                                document.getElementById(
                                    "cash"
                                ).value
                            ) || 0;


                        if (cash < total) {

                            alert(
                                "Insufficient cash."
                            );

                            return;

                        }

                    }


                    // =================================================
                    // DIGITAL PAYMENT
                    // =================================================

                    else {

                        paymentDetail =
                            document.getElementById(
                                "paymentDetail"
                            ).value;


                        let referenceNo =
                            document.getElementById(
                                "referenceNo"
                            ).value.trim();


                        if (referenceNo === "") {

                            alert(
                                "Please enter Reference Number."
                            );

                            return;

                        }

                    }


                    // =================================================
                    // CONVERT CART TO HISTORY
                    // =================================================

                    let sales =
                        cart.map(
                            item => ({

                                ItemID:
                                    item.id,

                                ItemName:
                                    item.name,

                                Category:
                                    item.category,

                                QuantitySold:
                                    item.qty,

                                SellingPrice:
                                    item.price,

                                PaymentType:
                                    paymentType,

                                PaymentDetail:
                                    paymentDetail

                            })
                        );


                    // =================================================
                    // SEND TO CONTROLLER
                    // =================================================

                    try {

                        const response =
                            await fetch(
                                "/Home/Checkout",
                                {

                                    method: "POST",

                                    headers: {

                                        "Content-Type":
                                            "application/json"

                                    },

                                    body:
                                        JSON.stringify(sales)

                                }
                            );


                        // =================================================
                        // SUCCESS
                        // =================================================

                        if (response.ok) {

                            alert(
                                "Checkout Successful!"
                            );


                            // CLEAR CART

                            cart = [];


                            loadCart();

                            updateBadge();


                            // RESET PAYMENT

                            document.getElementById(
                                "cash"
                            ).value = 0;


                            document.getElementById(
                                "change"
                            ).value = "0.00";


                            document.getElementById(
                                "referenceNo"
                            ).value = "";


                            // RESET PAYMENT TYPE

                            document.getElementById(
                                "paymentType"
                            ).value = "Cash";


                            document.getElementById(
                                "cashSection"
                            ).style.display = "block";


                            document.getElementById(
                                "digitalSection"
                            ).style.display = "none";


                            // REFRESH

                            location.reload();

                        }

                        // =================================================
                        // FAILED (e.g. naubos na ang stock)
                        // =================================================

                        else {

                            let err = null;

                            try {

                                err = await response.json();

                            }
                            catch (e) {

                                err = null;

                            }


                            if (err && err.items) {

                                alert(
                                    "Naubos na ang stock sa: " +
                                    err.items.join(", ") +
                                    "\nPlease remove/adjust sa cart."
                                );

                            }
                            else {

                                alert(
                                    "Checkout failed."
                                );

                            }

                        }

                    }

                    catch (error) {

                        console.error(error);

                        alert(
                            "An error occurred during checkout."
                        );

                    }

                }
            );


        // =========================================================
        // DEFAULT DISPLAY
        // =========================================================

        document.getElementById(
            "cashSection"
        ).style.display = "block";


        document.getElementById(
            "digitalSection"
        ).style.display = "none";


        // INITIAL LOAD

        loadCart();

        updateBadge();

    </script>

}
