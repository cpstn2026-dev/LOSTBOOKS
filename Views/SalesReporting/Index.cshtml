@using LOSTBOOKS.ViewModels
@using LOSTBOOKS.ViewModels.SalesAnalysisViewModel

@{
    ViewData["Title"] = "Sales Reporting";

    decimal totalSales =
        ViewBag.TotalSales ?? 0m;

    int totalTransactions =
        ViewBag.TotalTransactions ?? 0;

    int totalQuantitySold =
        ViewBag.TotalQuantitySold ?? 0;

    decimal averageTransactionValue =
        ViewBag.AverageTransactionValue ?? 0m;

    var composition =
        (CompositionSummary)ViewBag.Composition;

    string compositionJson =
        ViewBag.CompositionJson ?? "[]";

    string finalSummary =
        ViewBag.FinalSummary ?? "";

    string topItem =
        ViewBag.TopItem ?? "-";

    string bestCategory =
        ViewBag.BestCategory ?? "-";

    string categoryText =
        ViewBag.CategoryText ?? "All Categories";

    string periodText =
        ViewBag.PeriodText ?? "All Dates";

    string selectedRange =
        ViewBag.Range ?? "";

    string fromDate =
        ViewBag.FromDate ?? "";

    string toDate =
        ViewBag.ToDate ?? "";

    string selectedCategory =
        ViewBag.Category ?? "All";

    string salesTrendJson =
        ViewBag.SalesTrendJson ?? "[]";

    string topItemsJson =
        ViewBag.TopItemsJson ?? "[]";

    // NEW
    List<string> growthFindings =
        ViewBag.GrowthFindings ?? new List<string>();

    string? growthInsightText =
        ViewBag.GrowthInsightText;

    string? growthConsider =
        ViewBag.GrowthConsider;

    string growthBasis =
        ViewBag.GrowthBasis ?? "";

    List<string> trendFindings =
        ViewBag.TrendFindings ?? new List<string>();

    string? trendInsightText =
        ViewBag.TrendInsightText;

    string? trendConsider =
        ViewBag.TrendConsider;

    string trendBasis =
        ViewBag.TrendBasis ?? "";

    List<string> compositionFindings =
        ViewBag.CompositionFindings ?? new List<string>();

    string? compositionInsightText =
        ViewBag.CompositionInsightText;

    string? compositionConsider =
        ViewBag.CompositionConsider;

    string compositionBasis =
        ViewBag.CompositionBasis ?? "";

    List<string> itemFindings =
        ViewBag.ItemFindings ?? new List<string>();

    string? itemInsightText =
        ViewBag.ItemInsightText;

    string? itemConsider =
        ViewBag.ItemConsider;

    string itemBasis =
        ViewBag.ItemBasis ?? "";

    List<string> itemConcentrationFindings =
        ViewBag.ItemConcentrationFindings ?? new List<string>();

    string? itemConcentrationInsightText =
        ViewBag.ItemConcentrationInsightText;

    string? itemConcentrationConsider =
        ViewBag.ItemConcentrationConsider;

    string itemConcentrationBasis =
        ViewBag.ItemConcentrationBasis ?? "";


    // =====================================================
    // ANALYSIS DATA
    // =====================================================

    var growth =
        (SalesGrowthAnalysis)ViewBag.SalesGrowth;

    var catAnalysis =
        (CategoryAnalysisSummary)ViewBag.CategoryAnalysis;

    var itemAnalysis =
        (ItemAnalysisSummary)ViewBag.ItemAnalysis;

    var trend =
        (TrendAnalysis)ViewBag.TrendAnalysis;
}

<!-- =========================================================
     CHART.JS
========================================================== -->

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>


<div class="container-fluid">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="fw-bold text-success mb-0">
            <i class="bi bi-graph-up-arrow"></i>
            Sales Reporting &amp; Analysis
        </h2>

        <a asp-controller="SalesReporting"
           asp-action="ViewPdf"
           asp-route-range="@selectedRange"
           asp-route-fromDate="@fromDate"
           asp-route-toDate="@toDate"
           asp-route-category="@selectedCategory"
           target="_blank"
           class="btn btn-success">
            <i class="bi bi-eye"></i>
            View
        </a>

    </div>

    <p class="text-muted small mb-4">
        <i class="bi bi-info-circle"></i>
        Analysis sections below identify patterns, comparisons, and relationships in your sales data —
        they do not determine the causes behind them.
    </p>


    <!-- =====================================================
         FILTER CARD
    ====================================================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form method="get"
                  asp-controller="SalesReporting"
                  asp-action="Index">

                <div class="row align-items-end">

                    <div class="col-md-3 mb-3">
                        <label for="range" class="form-label fw-bold">
                            Report Period
                        </label>

                        <select name="range"
                                id="range"
                                class="form-select">

                            <option value=""
                                    selected="@(selectedRange == "" ? "selected" : null)">
                                All Dates
                            </option>

                            <option value="daily"
                                    selected="@(selectedRange.Equals("daily", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                Daily
                            </option>

                            <option value="weekly"
                                    selected="@(selectedRange.Equals("weekly", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                Weekly
                            </option>

                            <option value="monthly"
                                    selected="@(selectedRange.Equals("monthly", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                Monthly
                            </option>

                            <option value="custom"
                                    selected="@(selectedRange.Equals("custom", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                Custom
                            </option>

                        </select>
                    </div>


                    <div class="col-md-3 mb-3">

                        <label for="fromDate"
                               class="form-label fw-bold">
                            From Date
                        </label>

                        <input type="date"
                               id="fromDate"
                               name="fromDate"
                               class="form-control"
                               value="@fromDate" />

                    </div>


                    <div class="col-md-3 mb-3">

                        <label for="toDate"
                               class="form-label fw-bold">
                            To Date
                        </label>

                        <input type="date"
                               id="toDate"
                               name="toDate"
                               class="form-control"
                               value="@toDate" />

                    </div>


                    <div class="col-md-3 mb-3">

                        <label for="category"
                               class="form-label fw-bold">
                            Category
                        </label>

                        <select name="category"
                                id="category"
                                class="form-select">

                            <option value="All"
                                    selected="@(selectedCategory == "All" ? "selected" : null)">
                                All Categories
                            </option>

                            <option value="Books"
                                    selected="@(selectedCategory == "Books" ? "selected" : null)">
                                Books
                            </option>

                            <option value="Products"
                                    selected="@(selectedCategory == "Products" ? "selected" : null)">
                                Products
                            </option>

                            <option value="Merchandise"
                                    selected="@(selectedCategory == "Merchandise" ? "selected" : null)">
                                Merchandise
                            </option>

                            <option value="Services"
                                    selected="@(selectedCategory == "Services" ? "selected" : null)">
                                Services
                            </option>

                        </select>

                    </div>

                </div>


                <div class="mt-2">

                    <button type="submit"
                            class="btn btn-success me-2">

                        <i class="bi bi-funnel-fill"></i>
                        Apply

                    </button>

                    <a asp-controller="SalesReporting"
                       asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-counterclockwise"></i>
                        Reset

                    </a>

                </div>

            </form>

        </div>

    </div>


    <!-- =====================================================
         SUMMARY
    ====================================================== -->

    <div class="row mb-4">

        <div class="col-md-3 mb-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Sales
                    </h6>

                    <h3 class="fw-bold text-success">
                        ₱@totalSales.ToString("N2")
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-3 mb-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Transactions
                    </h6>

                    <h3 class="fw-bold">
                        @totalTransactions
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-3 mb-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Top Selling Item
                    </h6>

                    <h5 class="fw-bold text-success">
                        @topItem
                    </h5>

                </div>

            </div>

        </div>


        <div class="col-md-3 mb-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Best Performing Category
                    </h6>

                    <h5 class="fw-bold text-success">
                        @bestCategory
                    </h5>

                </div>

            </div>

        </div>


        <div class="col-md-3 mb-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Quantity Sold
                    </h6>

                    <h3 class="fw-bold">
                        @totalQuantitySold
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-3 mb-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Average Transaction Value
                    </h6>

                    <h3 class="fw-bold text-success">
                        ₱@averageTransactionValue.ToString("N2")
                    </h3>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         OVERALL SALES ANALYSIS
    ====================================================== -->
    @if (totalTransactions > 0)
    {
        <div class="alert alert-success border-start border-success border-4 mb-4"
             style="background-color:#f1f9f4;">

            <small class="text-success fw-bold text-uppercase" style="letter-spacing:0.5px;">
                <i class="bi bi-search"></i> Analysis
            </small>

            <div class="mt-2">
                <strong>Finding:</strong>
                <ul class="mb-0 mt-1">
                    @foreach (var line in growthFindings)
                    {
                        <li>@line</li>
                    }
                </ul>
            </div>

            @if (!string.IsNullOrWhiteSpace(growthInsightText))
            {
                <div class="mt-2">
                    <i class="bi bi-lightbulb"></i>
                    <strong>Insight:</strong>
                    <span>@growthInsightText</span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(growthConsider))
            {
                <div class="mt-2">
                    <strong>Consider:</strong>
                    <span>@growthConsider</span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(growthBasis))
            {
                <div class="mt-2">
                    <small class="text-muted"><em>Basis: @growthBasis</em></small>
                </div>
            }

        </div>
    }


    <!-- =====================================================
         REPORT INFORMATION
    ====================================================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <strong>Report Period:</strong>
            @periodText

            &nbsp;&nbsp;&nbsp;

            <strong>Category:</strong>
            @categoryText

        </div>

    </div>


    <!-- =====================================================
         SALES TREND + CATEGORY PERFORMANCE
    ====================================================== -->

    <div class="row mb-4">


        <!-- SALES TREND -->

        <div class="col-lg-8 mb-3">

            <div class="card shadow-sm h-100">

                <div class="card-header bg-success text-white fw-bold">
                    Sales Trend
                </div>

                <div class="px-3 pt-2">
                    <small class="text-muted fw-bold text-uppercase" style="letter-spacing:0.5px;">
                        <i class="bi bi-bar-chart-fill"></i> Report
                    </small>
                </div>

                <div class="card-body"
                     style="height:380px; position:relative;">

                    <canvas id="salesTrendChart"></canvas>

                    <div id="salesTrendNoData"
                         class="text-center text-muted d-none h-100 d-flex align-items-center justify-content-center">

                        No sales trend data available.

                    </div>

                </div>


                <div class="card-footer"
                     style="background-color:#f1f9f4;">

                    <small class="text-success fw-bold text-uppercase" style="letter-spacing:0.5px;">
                        <i class="bi bi-search"></i> Analysis
                    </small>

                    <div class="mt-2">
                        <strong>Finding:</strong>
                        <ul class="mb-0 mt-1">
                            @foreach (var line in trendFindings)
                            {
                                <li>@line</li>
                            }
                        </ul>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(trendInsightText))
                    {
                        <div class="mt-2">
                            <i class="bi bi-lightbulb"></i>
                            <strong>Insight:</strong>
                            <span>@trendInsightText</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(trendConsider))
                    {
                        <div class="mt-2">
                            <strong>Consider:</strong>
                            <span>@trendConsider</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(trendBasis))
                    {
                        <div class="mt-2">
                            <small class="text-muted"><em>Basis: @trendBasis</em></small>
                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- CATEGORY PERFORMANCE / COMPOSITION -->

        <div class="col-lg-4 mb-3">

            <div class="card shadow-sm h-100">

                <div class="card-header bg-success text-white fw-bold">
                    @composition.ChartTitle
                </div>

                <div class="px-3 pt-2">
                    <small class="text-muted fw-bold text-uppercase" style="letter-spacing:0.5px;">
                        <i class="bi bi-bar-chart-fill"></i> Report
                    </small>
                </div>

                <div class="card-body"
                     style="height:380px; position:relative;">

                    <canvas id="categoryPerformanceChart"></canvas>

                    <div id="categoryNoData"
                         class="text-center text-muted d-none h-100 d-flex align-items-center justify-content-center">

                        No category data available.

                    </div>

                </div>


                                <div class="card-footer"
                     style="background-color:#f1f9f4;">

                    <small class="text-success fw-bold text-uppercase" style="letter-spacing:0.5px;">
                        <i class="bi bi-search"></i> Analysis
                    </small>

                    <div class="mt-2">
                        <strong>Finding:</strong>
                        <ul class="mb-0 mt-1">
                            @foreach (var line in compositionFindings)
                            {
                                <li>@line</li>
                            }
                        </ul>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(compositionInsightText))
                    {
                        <div class="mt-2">
                            <i class="bi bi-lightbulb"></i>
                            <strong>Insight:</strong>
                            <span>@compositionInsightText</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(compositionConsider))
                    {
                        <div class="mt-2">
                            <strong>Consider:</strong>
                            <span>@compositionConsider</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(compositionBasis))
                    {
                        <div class="mt-2">
                            <small class="text-muted"><em>Basis: @compositionBasis</em></small>
                        </div>
                    }

                </div>

            </div>

        </div>

        </div>


    <!-- =====================================================
         CATEGORY DETAILS
    ====================================================== -->
    @if (catAnalysis.Categories.Count > 0 &&
             !composition.IsSingleCategory)
    {
        <div class="card shadow-sm mb-4">

            <div class="card-header bg-success text-white fw-bold">
                Category Performance
            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover table-bordered align-middle mb-0">

                        <thead>

                            <tr>

                                <th>Category</th>

                                <th class="text-end">
                                    Current Sales
                                </th>

                                @if (catAnalysis.HasPreviousPeriod)
                                {
                                    <th class="text-end">
                                        Previous Sales
                                    </th>

                                    <th class="text-end">
                                        Change %
                                    </th>
                                }

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var cat in catAnalysis.Categories)
                            {
                                <tr>

                                    <td>
                                        @cat.Category
                                    </td>

                                    <td class="text-end">
                                        ₱@cat.CurrentSales.ToString("N2")
                                    </td>

                                    @if (catAnalysis.HasPreviousPeriod)
                                    {
                                        <td class="text-end">
                                            ₱@cat.PreviousSales.ToString("N2")
                                        </td>

                                        <td class="text-end">

                                            @(cat.ChangePercent.HasValue
                                                ? (cat.ChangePercent.Value >= 0 ? "+" : "")
                                                  + cat.ChangePercent.Value.ToString("N2")
                                                  + "%"
                                                : "-")

                                        </td>
                                    }

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }


    <!-- =====================================================
         TOP SELLING ITEMS
    ====================================================== -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-success text-white fw-bold">
                Top Selling Items
            </div>

            <div class="px-3 pt-2">
                <small class="text-muted fw-bold text-uppercase" style="letter-spacing:0.5px;">
                    <i class="bi bi-bar-chart-fill"></i> Report
                </small>
            </div>

            <div class="card-body"
                 style="height:400px; position:relative;">

                <canvas id="topItemsChart"></canvas>

                <div id="topItemsNoData"
                     class="text-center text-muted d-none h-100 d-flex align-items-center justify-content-center">

                    No top-selling item data available.

                </div>

            </div>


                        <div class="card-footer"
                 style="background-color:#f1f9f4;">

                <small class="text-success fw-bold text-uppercase" style="letter-spacing:0.5px;">
                    <i class="bi bi-search"></i> Analysis
                </small>

                <div class="mt-2">
                    <strong>Finding:</strong>
                    <ul class="mb-0 mt-1">
                        @foreach (var line in itemFindings)
                        {
                            <li>@line</li>
                        }
                    </ul>
                </div>

                @if (!string.IsNullOrWhiteSpace(itemInsightText))
                {
                    <div class="mt-2">
                        <i class="bi bi-lightbulb"></i>
                        <strong>Insight:</strong>
                        <span>@itemInsightText</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(itemConsider))
                {
                    <div class="mt-2">
                        <strong>Consider:</strong>
                        <span>@itemConsider</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(itemBasis))
                {
                    <div class="mt-2">
                        <small class="text-muted"><em>Basis: @itemBasis</em></small>
                    </div>
                }

            </div>

        </div>


    <!-- =====================================================
         ITEM RANKING
    ====================================================== -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-success text-white fw-bold">
                Item Ranking
            </div>

            <div class="px-3 pt-2">
                <small class="text-muted fw-bold text-uppercase" style="letter-spacing:0.5px;">
                    <i class="bi bi-bar-chart-fill"></i> Report
                </small>
            </div>

            <div class="card-body">

            @if (itemAnalysis.AllItems == null ||
                 itemAnalysis.AllItems.Count == 0)
            {
                <p class="text-muted mb-0">
                    No item data available for the selected period.
                </p>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover table-bordered align-middle mb-0">

                        <thead>

                            <tr>

                                <th>Rank</th>

                                <th>Item</th>

                                <th>Category</th>

                                <th class="text-end">
                                    Quantity Sold
                                </th>

                                <th class="text-end">
                                    Total Sales
                                </th>

                                @if (itemAnalysis.HasPreviousPeriod)
                                {
                                    <th class="text-end">
                                        Change
                                    </th>
                                }

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int rank = 1;
                            }

                            @foreach (var item in itemAnalysis.AllItems)
                            {
                                <tr>

                                    <td>
                                        #@rank
                                    </td>

                                    <td>
                                        @item.ItemName
                                    </td>

                                    <td>
                                        @item.Category
                                    </td>

                                    <td class="text-end">
                                        @item.CurrentQuantity
                                    </td>

                                    <td class="text-end">
                                        ₱@item.CurrentSales.ToString("N2")
                                    </td>

                                    @if (itemAnalysis.HasPreviousPeriod)
                                    {
                                        <td class="text-end">

                                            @(item.QuantityChangePercent.HasValue
                                                ? (item.QuantityChangePercent.Value >= 0 ? "+" : "")
                                                  + item.QuantityChangePercent.Value.ToString("N2")
                                                  + "%"
                                                : "-")

                                        </td>
                                    }

                                </tr>

                                rank++;
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>


                        <div class="card-footer"
                 style="background-color:#f1f9f4;">

                <small class="text-success fw-bold text-uppercase" style="letter-spacing:0.5px;">
                    <i class="bi bi-search"></i> Analysis
                </small>

                <div class="mt-2">
                    <strong>Finding:</strong>
                    <ul class="mb-0 mt-1">
                        @foreach (var line in itemConcentrationFindings)
                        {
                            <li>@line</li>
                        }
                    </ul>
                </div>

                @if (!string.IsNullOrWhiteSpace(itemConcentrationInsightText))
                {
                    <div class="mt-2">
                        <i class="bi bi-lightbulb"></i>
                        <strong>Insight:</strong>
                        <span>@itemConcentrationInsightText</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(itemConcentrationConsider))
                {
                    <div class="mt-2">
                        <strong>Consider:</strong>
                        <span>@itemConcentrationConsider</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(itemConcentrationBasis))
                {
                    <div class="mt-2">
                        <small class="text-muted"><em>Basis: @itemConcentrationBasis</em></small>
                    </div>
                }

            </div>

        </div>


    <!-- =====================================================
         FINAL ANALYSIS SUMMARY
    ====================================================== -->

    <div class="card shadow-sm mb-4 border-success">

        <div class="card-header bg-success text-white fw-bold">
            Final Analysis Summary
        </div>

        <div class="card-body">

            <p class="mb-0">
                @finalSummary
            </p>

        </div>

    </div>

</div>


<!-- =============================================================
     JAVASCRIPT
============================================================== -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

    if (typeof Chart === "undefined") {
    console.error("Chart.js failed to load.");
    return;
    }

    const salesTrendData =
    @Html.Raw(salesTrendJson);

    const categoryPerformanceData =
    @Html.Raw(compositionJson);

    const topItemsData =
    @Html.Raw(topItemsJson);


    /* =====================================================
    SALES TREND
    ===================================================== */

    const salesTrendCanvas =
    document.getElementById("salesTrendChart");

    const salesTrendNoData =
    document.getElementById("salesTrendNoData");

    if (salesTrendCanvas &&
    Array.isArray(salesTrendData) &&
    salesTrendData.length > 0) {

    const labels =
    salesTrendData.map(item => item.Date);

    const values =
    salesTrendData.map(item => Number(item.Total));

    new Chart(salesTrendCanvas, {

    type: "line",

    data: {

    labels: labels,

    datasets: [{

    label: "Total Sales",

    data: values,

    borderColor: "#198754",

    backgroundColor:
    "rgba(25,135,84,0.12)",

    borderWidth: 3,

    pointBackgroundColor: "#198754",

    pointBorderColor: "#198754",

    pointRadius: 4,

    pointHoverRadius: 6,

    tension: 0.3,

    fill: true

    }]

    },

    options: {

    responsive: true,

    maintainAspectRatio: false,

    interaction: {
    intersect: false,
    mode: "index"
    },

    plugins: {

    legend: {
    display: true,
    position: "top"
    },

    tooltip: {

    callbacks: {

    label: function (context) {

    return "₱" +
    Number(context.raw)
    .toLocaleString(
    "en-PH",
    {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
    });

    }

    }

    }

    },

    scales: {

    x: {

    title: {
    display: true,
    text: "Date"
    },

    grid: {
    display: false
    }

    },

    y: {

    beginAtZero: true,

    title: {
    display: true,
    text: "Sales"
    },

    ticks: {

    callback: function (value) {

    return "₱" +
    Number(value)
    .toLocaleString("en-PH");

    }

    }

    }

    }

    }

    });

    }
    else {

    if (salesTrendCanvas)
    salesTrendCanvas.style.display = "none";

    if (salesTrendNoData)
    salesTrendNoData.classList.remove("d-none");

    }


    /* =====================================================
    CATEGORY PERFORMANCE / COMPOSITION
    ===================================================== */

    const categoryCanvas =
    document.getElementById(
    "categoryPerformanceChart"
    );

    const categoryNoData =
    document.getElementById(
    "categoryNoData"
    );

    if (categoryCanvas &&
    Array.isArray(categoryPerformanceData) &&
    categoryPerformanceData.length > 0) {

    const labels =
    categoryPerformanceData
    .map(item => item.Label);

    const values =
    categoryPerformanceData
    .map(item => Number(item.Total));

    new Chart(categoryCanvas, {

    type: "pie",

    data: {

    labels: labels,

    datasets: [{

    label: "Sales",

    data: values,

    backgroundColor: [
    "#198754",
    "#ffc107",
    "#0d6efd",
    "#dc3545",
    "#6f42c1",
    "#20c997"
    ],

    borderColor: "#ffffff",

    borderWidth: 2

    }]

    },

    options: {

    responsive: true,

    maintainAspectRatio: false,

    plugins: {

    legend: {
    display: true,
    position: "bottom"
    },

    tooltip: {

    callbacks: {

    label: function (context) {

    const value =
    Number(context.raw);

    const total =
    context.dataset.data
    .reduce(
    (sum, n) =>
    sum + Number(n),
    0
    );

    const percentage =
    total > 0
    ? (value / total * 100)
    .toFixed(1)
    : 0;

    return context.label +
    ": ₱" +
    value.toLocaleString(
    "en-PH",
    {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
    }
    ) +
    " (" +
    percentage +
    "%)";

    }

    }

    }

    }

    }

    });

    }
    else {

    if (categoryCanvas)
    categoryCanvas.style.display = "none";

    if (categoryNoData)
    categoryNoData.classList.remove("d-none");

    }


    /* =====================================================
    TOP SELLING ITEMS
    ===================================================== */

    const topItemsCanvas =
    document.getElementById(
    "topItemsChart"
    );

    const topItemsNoData =
    document.getElementById(
    "topItemsNoData"
    );

    if (topItemsCanvas &&
    Array.isArray(topItemsData) &&
    topItemsData.length > 0) {

    const labels =
    topItemsData
    .map(item => item.ItemName);

    const quantities =
    topItemsData
    .map(item => Number(item.Quantity));

    new Chart(topItemsCanvas, {

    type: "bar",

    data: {

    labels: labels,

    datasets: [{

    label: "Quantity Sold",

    data: quantities,

    backgroundColor: "#198754",

    borderColor: "#157347",

    borderWidth: 1,

    borderRadius: 5,

    maxBarThickness: 70

    }]

    },

    options: {

    responsive: true,

    maintainAspectRatio: false,

    plugins: {

    legend: {
    display: true,
    position: "top"
    },

    tooltip: {

    callbacks: {

    label: function (context) {

    return "Quantity Sold: " +
    Number(context.raw)
    .toLocaleString();

    }

    }

    }

    },

    scales: {

    x: {

    title: {
    display: true,
    text: "Item"
    },

    grid: {
    display: false
    }

    },

    y: {

    beginAtZero: true,

    ticks: {
    precision: 0
    },

    title: {
    display: true,
    text: "Quantity Sold"
    }

    }

    }

    }

    });

    }
    else {

    if (topItemsCanvas)
    topItemsCanvas.style.display = "none";

    if (topItemsNoData)
    topItemsNoData.classList.remove("d-none");

    }

    });

</script>