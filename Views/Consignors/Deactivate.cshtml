@model LOSTBOOKS.Models.Consignor

@{
    ViewData["Title"] = "Deactivate";
}

<div style="font-family: sans-serif; padding: 20px; max-width: 800px; margin: 0 auto;">

    <h3>Are you sure you want to deactivate this consignor?</h3>
    <p style="color:gray;">
        The consignor's record and sales history will be kept —
        they just won't be selectable for new items anymore.
    </p>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Consignor Name</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ConsignorName)</dd>

        <dt class="col-sm-3">Contact Number</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ContactNumber)</dd>

        <dt class="col-sm-3">Email Address</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.EmailAddress)</dd>
    </dl>

    <form asp-action="Deactivate">
        <input type="hidden" asp-for="ConsignorID" />

        <div style="text-align: center; margin-top: 40px;">
            <input type="submit"
                   value="deactivate"
                   style="background-color: red; color: white; border: none; padding: 8px 20px; font-size: 16px; cursor: pointer; margin-right: 15px;" />

            <a asp-action="Index"
               style="background-color: blue; color: white; border: none; padding: 8px 20px; font-size: 16px; text-decoration: none; display: inline-block;">
                cancel
            </a>
        </div>
    </form>

</div>
