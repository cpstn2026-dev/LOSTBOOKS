@model List<LOSTBOOKS.ViewModels.POSViewModels>

@{
    ViewData["Title"] = "PAGE & POUR POS";
}

<h2>PAGE & POUR POS</h2>

<form asp-action="Index" method="get" class="mb-3">

    <div class="row">

        <div class="col-md-4">

            <input type="text"
                   class="form-control"
                   name="search"
                   placeholder="Search Item..."
                   value="@Context.Request.Query["search"]" />

        </div>

        <div class="col-md-3">

            <select class="form-select"
                    name="category"
                    onchange="this.form.submit()">

                <option value="All">All</option>
                <option value="Books">Books</option>
                <option value="Products">Products</option>
                <option value="Merchandise">Merchandise</option>
                <option value="Services">Services</option>

            </select>

        </div>

        <div class="col-md-2">

            <button type="submit"
                    class="btn btn-primary w-100">

                Search

            </button>

        </div>

        <div class="col-md-3">

            <button type="button"
                    class="btn btn-dark w-100"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#shoppingBag">

                🛒 Shopping Bag

            </button>

        </div>

    </div>

</form>

<table class="table table-bordered table-hover">

    <thead class="table-dark">

        <tr>

            <th>ID</th>
            <th>Item Name</th>
            <th>Category</th>
            <th>Price</th>
            <th width="150">Action</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Id</td>

                <td>@item.Name</td>

                <td>@item.Category</td>

                <td>₱@item.Price</td>

                <td>

                    <button class="btn btn-success w-100"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#cartModal"
                            data-name="@item.Name"
                            data-price="@item.Price"
                            data-category="@item.Category"
                            data-stock="@item.Stock">

                        Add To Cart

                    </button>

                </td>

            </tr>
        }

    </tbody>

</table>

<!-- ================= ADD TO CART MODAL ================= -->

<div class="modal fade"
     id="cartModal"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h4>Add To Cart</h4>

                <button class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <label>Item Name</label>

                <input id="itemName"
                       class="form-control"
                       readonly />

                <br />

                <label>Price</label>

                <input id="itemPrice"
                       class="form-control"
                       readonly />

                <br />

                <div id="qtySection">

                    <label>Quantity</label>

                    <div class="input-group">

                        <button type="button"
                                class="btn btn-secondary"
                                onclick="minusQty()">

                            -

                        </button>

                        <input id="qty"
                               type="number"
                               class="form-control text-center"
                               value="1"
                               min="1"
                               onchange="computeTotal()" />

                        <button type="button"
                                class="btn btn-secondary"
                                onclick="addQty()">

                            +

                        </button>

                    </div>

                </div>

                <br />

                <h5>

                    Total :
                    ₱<span id="totalPrice">0.00</span>

                </h5>

            </div>

            <div class="modal-footer">

                <button id="btnAddCart"
                        type="button"
                        class="btn btn-success">

                    Add To Cart

                </button>

                <button class="btn btn-danger"
                        data-bs-dismiss="modal">

                    Cancel

                </button>

            </div>

        </div>

    </div>

</div>


<!-- ================= SHOPPING BAG ================= -->

<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="shoppingBag"
     style="width:450px;">

    <div class="offcanvas-header">

        <h4>🛒 Shopping Bag</h4>

        <button class="btn-close"
                data-bs-dismiss="offcanvas">
        </button>

    </div>

    <div class="offcanvas-body">

        <table class="table table-sm table-bordered">

            <thead class="table-light">

                <tr>

                    <th>Item</th>
                    <th width="60">Qty</th>
                    <th width="90">Total</th>
                    <th width="50"></th>

                </tr>

            </thead>

            <tbody id="cartItems">

                <tr>

                    <td colspan="4"
                        class="text-center text-muted">

                        No items in cart.

                    </td>

                </tr>

            </tbody>

        </table>

        <hr />

        <div class="mb-3">

            <label class="form-label">

                Total

            </label>

            <input id="cartTotal"
                   class="form-control"
                   value="0.00"
                   readonly />

        </div>

        <div class="mb-3">

            <label class="form-label">

                Payment Type

            </label>

            <select id="paymentType"
                    class="form-select">

                <option>Cash</option>
                <option>GCash</option>

            </select>

        </div>

      <div id="cashSection">

    <div class="mb-3">

        <label class="form-label">
            Cash Received
        </label>

        <input id="cash"
               type="number"
               class="form-control"
               value="0"
               onkeyup="computeChange()"
               onchange="computeChange()" />

    </div>

    <div class="mb-3">

        <label class="form-label">
            Change
        </label>

        <input id="change"
               class="form-control"
               value="0.00"
               readonly />

    </div>

    </div>

    <div id="gcashSection" style="display:none;">

        <div class="mb-3">

            <label class="form-label">
                GCash Reference No.
            </label>

            <input id="referenceNo"
                   class="form-control"
                   placeholder="Enter Reference Number" />

        </div>

        <div class="alert alert-success">

            ✔ Payment will be verified using the reference number.

        </div>

    </div>

        <div class="d-grid gap-2">

            <button id="btnClear"
                    class="btn btn-danger">

                Clear Cart

            </button>

            <button id="btnCheckout"
                    class="btn btn-success">

                Checkout

            </button>

        </div>

    </div>

</div>



 @section Scripts{

<script>

    // ===========================
    // VARIABLES
    // ===========================

    let price = 0;
    let stock = 0;
    let category = "";
    let cart = [];

    // ===========================
    // OPEN ADD TO CART MODAL
    // ===========================

    const modal = document.getElementById("cartModal");

    modal.addEventListener("show.bs.modal", function (event) {

        let button = event.relatedTarget;

        // Get Item Information
        document.getElementById("itemName").value = button.dataset.name;
        document.getElementById("itemPrice").value = button.dataset.price;

        price = parseFloat(button.dataset.price);
        stock = parseInt(button.dataset.stock);
        category = button.dataset.category;

        // Default Quantity
        document.getElementById("qty").value = 1;

        // Hide Quantity if Service
        if (category == "Services") {

            document.getElementById("qtySection").style.display = "none";

        }
        else {

            document.getElementById("qtySection").style.display = "block";

        }

        computeTotal();

    });

    // ===========================
    // ADD QUANTITY
    // ===========================

    function addQty() {

        let qty = document.getElementById("qty");

        // Unlimited Products
        if (category == "Products") {

            qty.value++;

        }

        // Books & Merchandise
        else {

            if (parseInt(qty.value) < stock) {

                qty.value++;

            }

        }

        computeTotal();

    }

    // ===========================
    // MINUS QUANTITY
    // ===========================

    function minusQty() {

        let qty = document.getElementById("qty");

        if (qty.value > 1) {

            qty.value--;

        }

        computeTotal();

    }

    // ===========================
    // COMPUTE TOTAL
    // ===========================

    function computeTotal() {

        let qty = parseInt(document.getElementById("qty").value);

        let total = price * qty;

        document.getElementById("totalPrice").innerHTML =
            total.toFixed(2);

    }

    // ===========================
    // ADD ITEM TO CART
    // ===========================

    document.getElementById("btnAddCart").addEventListener("click", function () {

        let qty;

        if (category == "Services") {

            qty = 1;

        }
        else {

            qty = parseInt(document.getElementById("qty").value);

        }

        cart.push({

            name: document.getElementById("itemName").value,
            price: price,
            qty: qty

        });

        loadCart();

        bootstrap.Modal.getInstance(modal).hide();

    });

        // ===========================
    // LOAD SHOPPING BAG
    // ===========================

    function loadCart() {

        let html = "";
        let total = 0;

        // Check if cart is empty
        if (cart.length == 0) {

            html = `
                <tr>

                    <td colspan="4"
                        class="text-center text-muted">

                        No items in cart.

                    </td>

                </tr>
            `;

        }
        else {

            // Display all cart items
            cart.forEach(function (item, index) {

                let subTotal = item.price * item.qty;

                total += subTotal;

                html += `

                    <tr>

                        <td>

                            ${item.name}

                        </td>

                        <td>

                            ${item.qty}

                        </td>

                        <td>

                            ₱${subTotal.toFixed(2)}

                        </td>

                        <td>

                            <button
                                class="btn btn-danger btn-sm"
                                onclick="removeItem(${index})">

                                ✖

                            </button>

                        </td>

                    </tr>

                `;

            });

        }

        // Display Cart Items
        document.getElementById("cartItems").innerHTML = html;

        // Display Total Amount
        document.getElementById("cartTotal").value =
            total.toFixed(2);

        // Update Change
        computeChange();

    }

    // ===========================
    // REMOVE ITEM
    // ===========================

    function removeItem(index) {

        cart.splice(index, 1);

        loadCart();

    }

    // ===========================
    // CLEAR SHOPPING BAG
    // ===========================

    document.getElementById("btnClear").addEventListener("click", function () {

        if (confirm("Clear all items?")) {

            cart = [];

            loadCart();

            // Reset Payment
            document.getElementById("cash").value = 0;
            document.getElementById("change").value = "0.00";

            if (document.getElementById("referenceNo")) {

                document.getElementById("referenceNo").value = "";

            }

        }

    });


        // ===========================
    // COMPUTE CHANGE
    // ===========================

    function computeChange() {

        let total =
            parseFloat(document.getElementById("cartTotal").value) || 0;

        let cash =
            parseFloat(document.getElementById("cash").value) || 0;

        let change = cash - total;

        if (change < 0) {

            change = 0;

        }

        document.getElementById("change").value =
            change.toFixed(2);

    }

    // ===========================
    // PAYMENT TYPE
    // ===========================

    document.getElementById("paymentType").addEventListener("change", function () {

        if (this.value == "Cash") {

            // Show Cash Fields
            document.getElementById("cashSection").style.display = "block";
            document.getElementById("gcashSection").style.display = "none";

            computeChange();

        }
        else {

            // Show GCash Fields
            document.getElementById("cashSection").style.display = "none";
            document.getElementById("gcashSection").style.display = "block";

        }

    });

    // ===========================
    // CHECKOUT
    // ===========================

    document.getElementById("btnCheckout").addEventListener("click", function () {

        if (cart.length == 0) {

            alert("Shopping Bag is empty.");

            return;

        }

        // CASH PAYMENT
        if (document.getElementById("paymentType").value == "Cash") {

            let total =
                parseFloat(document.getElementById("cartTotal").value);

            let cash =
                parseFloat(document.getElementById("cash").value) || 0;

            if (cash < total) {

                alert("Insufficient cash.");

                return;

            }

            alert("Cash Payment Successful!");

        }

        // GCASH PAYMENT
        else {

            let ref =
                document.getElementById("referenceNo").value.trim();

            if (ref == "") {

                alert("Please enter GCash Reference Number.");

                return;

            }

            alert("GCash Payment Successful!");

        }

        // Clear Cart After Checkout
        cart = [];

        loadCart();

        document.getElementById("cash").value = 0;
        document.getElementById("change").value = "0.00";

        if (document.getElementById("referenceNo")) {

            document.getElementById("referenceNo").value = "";

        }

    });

    // ===========================
    // DEFAULT DISPLAY
    // ===========================

    document.getElementById("cashSection").style.display = "block";
    document.getElementById("gcashSection").style.display = "none";

</script>

}