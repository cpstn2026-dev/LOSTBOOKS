@model LOSTBOOKS.Models.Merchandise

@{
    ViewData["Title"] = "Delete";
}

<div style="font-family: sans-serif; padding: 20px; max-width: 800px; margin: 0 auto;">

    <h3>Are you sure you want to delete this?</h3>
    <h4>Merchandise</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-3">Merchandise Name</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.MerchandiseName)</dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Category)</dd>

        <dt class="col-sm-3">Selling Price</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.SellingPrice)</dd>

        <dt class="col-sm-3">Store Share %</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.StoreSharePercentage)</dd>

        <dt class="col-sm-3">Consignor ID</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.ConsignorID)</dd>

    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="MerchandiseID" />

        <div style="text-align: center; margin-top: 40px;">
            <input type="submit"
                   value="remove"
                   style="background-color: red; color: white; border: none; padding: 8px 20px; font-size: 16px; cursor: pointer; margin-right: 15px;" />

            <a asp-action="Index"
               style="background-color: blue; color: white; border: none; padding: 8px 20px; font-size: 16px; text-decoration: none; display: inline-block;">
                cancel
            </a>
        </div>
    </form>


</div>
