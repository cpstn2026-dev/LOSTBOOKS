@model LOSTBOOKS.Models.Consignor

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Consignor</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ConsignorName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ConsignorName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ContactNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ContactNumber)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EmailAddress)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EmailAddress)
        </dd>

        <dt class="col-sm-2">
            Status
        </dt>
        <dd class="col-sm-10">
            @if (Model.IsActive)
            {
                <span style="color:green; font-weight:bold;">Active</span>
            }
            else
            {
                <span style="color:gray; font-weight:bold;">Deactivated</span>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.ConsignorID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
