﻿@{
ViewData["Title"] = "Consignor Summary";

var consignors = ViewBag.Consignors;
}

<div class="container-fluid">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="fw-bold text-success mb-0">

            <i class="bi bi-people-fill"></i>
            Consignor Summary

        </h2>

    </div>


    <!-- =====================================================
         CONSIGNOR LIST
    ====================================================== -->

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Consignor ID</th>
                            <th>Consignor Name</th>
                            <th>Items Sold</th>
                            <th>Quantity Sold</th>
                            <th>Total Sales</th>
                            <th>Store Share</th>
                            <th>Consignor Share</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (consignors != null && consignors.Count > 0)
                        {
                            foreach (var c in consignors)
                            {
                                <tr>

                                    <td>CON-@(((int)c.ConsignorID).ToString("D4"))</td>

                                    <td>@c.ConsignorName</td>

                                    <td>@c.ItemsSold</td>

                                    <td>@c.QuantitySold</td>

                                    <td>₱@(((decimal)c.TotalSales).ToString("N2"))</td>

                                    <td>₱@(((decimal)c.StoreShare).ToString("N2"))</td>

                                    <td>₱@(((decimal)c.ConsignorShare).ToString("N2"))</td>

                                    <td>
                                        <a asp-controller="ConsignorSummary"
                                           asp-action="Details"
                                           asp-route-id="@c.ConsignorID"
                                           class="btn btn-sm btn-success">
                                            View Report
                                        </a>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    No consignor sales records found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>