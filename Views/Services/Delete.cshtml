@model LOSTBOOKS.Models.Service

@{
    ViewData["Title"] = "Delete";
}

<div style="font-family: sans-serif; padding: 20px; max-width: 800px; margin: 0 auto;">

    
    <h3>Are you sure you want to delete this?</h3>
    <h4>Service</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Service Type</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ServiceType)</dd>

        <dt class="col-sm-3">Size</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Size)</dd>

        <dt class="col-sm-3">Number of Pages</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.NumberOfPages)</dd>

        <dt class="col-sm-3">Cover Finish</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.CoverFinish)</dd>

        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.AssessedPrice)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ServiceID" />

        <div style="text-align: center; margin-top: 40px;">
            <input type="submit"
                   value="remove"
                   style="background-color: red; color: white; border: none; padding: 8px 20px; font-size: 16px; cursor: pointer; margin-right: 15px;" />

            <a asp-action="Index"
               style="background-color: blue; color: white; border: none; padding: 8px 20px; font-size: 16px; text-decoration: none; display: inline-block;">
                cancel
            </a>
        </div>
    </form>
    

</div>
