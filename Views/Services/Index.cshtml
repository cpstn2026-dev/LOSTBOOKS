@model IEnumerable<LOSTBOOKS.Models.Service>

@{
    ViewData["Title"] = "Index";
}
<h1>Service Management</h1>
<br />

<form asp-action="Create" method="post">

    <p>
        Customer Name:
        <input type="text"
               name="CustomerName"
               required />
    </p>

    <p>
        Contact Number:
        <input type="text"
               name="ContactNumber"
               required />
    </p>

    <p>
        Service Type:

        <label>
            <input type="radio"
                   name="ServiceType"
                   value="Rush"
                   required />
            Rush
        </label>

        <label>
            <input type="radio"
                   name="ServiceType"
                   value="Regular" />
            Regular
        </label>

    </p>

    <p>
        Size:
        <input type="text"
               name="Size"
               required />
    </p>

    <p>
        Number of Pages:
        <input type="number"
               name="NumberOfPages"
               required />
    </p>

    <p>
        Cover Finish:
        <input type="text"
               name="CoverFinish"
               required />
    </p>

    <p>
        Status:

        <label>
            <input type="radio"
                   name="Status"
                   value="Pending Assessment"
                   checked
                   onclick="togglePrice()" />

            Pending Assessment
        </label>

        <label style="margin-left:20px;">
            <input type="radio"
                   name="Status"
                   value="Ready for Payment"
                   onclick="togglePrice()" />

            Ready for Payment
        </label>

    </p>

    <p id="priceSection" style="display:none;">

        Assessed Price:

        <input type="number"
               step="0.01"
               name="AssessedPrice"
               id="AssessedPrice" />

    </p>

    <button type="submit">
        ADD
    </button>

</form>

<br />
<hr />
<br />

<form asp-action="Index" method="get" style="margin-bottom: 20px;">
    <input type="text" name="searchString" placeholder="Search services..." />
    <button type="submit">Search</button>
</form>

<table border="1" cellpadding="10" style="width:100%; border-collapse: collapse;">
    <thead>
        <tr style="background-color: #f2f2f2;">
            <th>ID</th>
             <th>Customer</th>
            <th>Contact Number</th>
            <th>Service Type</th>
            <th>Size</th>
            <th>Pages</th>
            <th>Cover Finish</th>
            <th>Status</th>
            <th>Assessed Price</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ServiceID</td>
                 <td>@item.CustomerName</td>
                 <td>@item.ContactNumber
                <td>@item.ServiceType</td>
                <td>@item.Size</td>
                <td>@item.NumberOfPages</td>
                <td>@item.CoverFinish</td>
                <td>@item.Status</td>
                <td>
                    @(item.AssessedPrice.HasValue
                        ? "₱" + item.AssessedPrice.Value
                        : "-")
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.ServiceID"
                       style="background-color: green; color: white; border: none; padding: 5px 15px; text-decoration: none;">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.ServiceID"
                       style="background-color: red; color: white; border: none; padding: 5px 15px; text-decoration: none;">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts{

<script>

function togglePrice(){

    var status =
        document.querySelector('input[name="Status"]:checked').value;

    if(status=="Ready for Payment"){

        document.getElementById("priceSection").style.display="block";

    }

    else{

        document.getElementById("priceSection").style.display="none";

        document.getElementById("AssessedPrice").value="";

    }

}

window.onload=togglePrice;

</script>

}