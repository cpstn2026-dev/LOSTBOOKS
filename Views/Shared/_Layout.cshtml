@inject LOSTBOOKS.Services.ICurrentUserService CurrentUserService
@inject LOSTBOOKS.Data.LOSTBOOKSContext DbContext

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - LOSTBOOKS
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/LOSTBOOKS.styles.css"
          asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

</head>

<body>

    @{
        var currentController =
            ViewContext.RouteData.Values["Controller"]?.ToString();

        var currentAction =
            ViewContext.RouteData.Values["Action"]?.ToString();

        // Reports is active if the current page belongs
        // to any of the Reports controllers.
       bool reportsActive =
            currentController == "SalesReporting" ||
            currentController == "ConsignorSummary";
            bool adminActive =
            currentController == "Users" ||
            currentController == "ActivityLogs";
    }

    <div class="d-flex">

        <!-- ===================================================== -->
        <!-- SIDEBAR -->
        <!-- ===================================================== -->

        <aside id="sidebar">

            <!-- ================= SIDEBAR HEADER ================= -->

            <div class="sidebar-header">

                <i class="bi bi-book-half"></i>

                <span>LOSTBOOKS</span>

            </div>

            <!-- ================= DASHBOARD ================= -->

            <a asp-controller="Home"
               asp-action="Index"
               class="sidebar-link @(currentController == "Home" ? "active" : "")">

                <i class="bi bi-house-door-fill"></i>

                <span>Dashboard</span>

            </a>

            <!-- ================= PRODUCTS ================= -->

            <a asp-controller="Products"
               asp-action="Index"
               class="sidebar-link @(currentController == "Products" ? "active" : "")">

                <i class="bi bi-box-seam"></i>

                <span>Products</span>

            </a>

            <!-- ================= SERVICES ================= -->

            <a asp-controller="Services"
               asp-action="Index"
               class="sidebar-link @(currentController == "Services" ? "active" : "")">

                <i class="bi bi-cup-hot-fill"></i>

                <span>Services</span>

            </a>

            <!-- ================= CONSIGNORS ================= -->

            <a asp-controller="Consignors"
               asp-action="Index"
               class="sidebar-link @(currentController == "Consignors" ? "active" : "")">

                <i class="bi bi-people-fill"></i>

                <span>Consignors</span>

            </a>

            <!-- ================= MERCHANDISE ================= -->

            <a asp-controller="Merchandises"
               asp-action="Index"
               class="sidebar-link @(currentController == "Merchandises" ? "active" : "")">

                <i class="bi bi-bag-fill"></i>

                <span>Merchandises</span>

            </a>

            <!-- ================= BOOKS ================= -->

            <a asp-controller="Books"
               asp-action="Index"
               class="sidebar-link @(currentController == "Books" ? "active" : "")">

                <i class="bi bi-book-fill"></i>

                <span>Books</span>

            </a>

            <!-- ================= HISTORY ================= -->

            <a asp-controller="History"
               asp-action="Index"
               class="sidebar-link @(currentController == "History" ? "active" : "")">

                <i class="bi bi-clock-history"></i>

                <span>History</span>

            </a>

            <!-- ================================================= -->
            <!-- REPORTS DROPDOWN -->
            <!-- ================================================= -->

            <div class="sidebar-dropdown">

                <!-- ================= REPORTS BUTTON ================= -->

                <a class="sidebar-link d-flex align-items-center justify-content-between @(reportsActive ? "active" : "")"
                   data-bs-toggle="collapse"
                   href="#reportsMenu"
                   role="button"
                   aria-expanded="@(reportsActive.ToString().ToLower())"
                   aria-controls="reportsMenu">

                    <span>

                        <i class="bi bi-bar-chart-line-fill"></i>

                        <span>Reports & Analysis</span>

                    </span>

                    <i class="bi bi-chevron-down"></i>

                </a>

                <!-- ================= REPORTS SUB MENU ================= -->

                <div class="collapse @(reportsActive ? "show" : "")"
                     id="reportsMenu">

                    <div class="ms-3">

                        <!-- ================================================= -->
                        <!-- SALES REPORTING & ANALYSIS -->
                        <!-- ================================================= -->

                        <a asp-controller="SalesReporting"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "SalesReporting" ? "active" : "")">

                            <i class="bi bi-graph-up-arrow"></i>

                            <span>Sales Reporting &amp; Analysis</span>

                        </a>

                        <!-- ================================================= -->
                        <!-- CONSIGNOR-BASED SUMMARY -->
                        <!-- ================================================= -->

                        <a asp-controller="ConsignorSummary"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "ConsignorSummary" ? "active" : "")">

                            <i class="bi bi-people"></i>

                            <span>Consignor Summary</span>

                        </a>

                    </div>

                </div>
            </div>

            <!--
            =================================================
            -->
            <!-- ADMINISTRATION DROPDOWN (Manager only) -->
            <!--
            =================================================
            -->

                      @if (CurrentUserService.IsManager)
            {
                <div class="sidebar-dropdown">

                    <a class="sidebar-link d-flex align-items-center justify-content-between @(adminActive ? "active" : "")"
                       data-bs-toggle="collapse"
                       href="#adminMenu"
                       role="button"
                       aria-expanded="@(adminActive.ToString().ToLower())"
                       aria-controls="adminMenu">

                        <span>

                            <i class="bi bi-shield-lock-fill"></i>

                            <span>Administration</span>

                        </span>

                        <i class="bi bi-chevron-down"></i>

                    </a>

                    <div class="collapse @(adminActive ? "show" : "")"
                         id="adminMenu">

                        <div class="ms-3">

                            <a asp-controller="Users"
                               asp-action="Index"
                               class="sidebar-link @(currentController == "Users" ? "active" : "")">

                                <i class="bi bi-people-fill"></i>

                                <span>Users</span>

                            </a>

                            <a asp-controller="ActivityLogs"
                               asp-action="Index"
                               class="sidebar-link @(currentController == "ActivityLogs" ? "active" : "")">

                                <i class="bi bi-list-check"></i>

                                <span>Activity Logs</span>

                            </a>

                        </div>

                    </div>

                </div>
            }
        </aside>

        <!-- ===================================================== -->
        <!-- MAIN CONTENT -->
        <!-- ===================================================== -->

        <div class="main-content">

            <!-- ================= TOPBAR ================= -->

            <nav class="navbar navbar-expand-lg bg-white shadow-sm px-4">

                <div class="container-fluid">

                    <!-- ================= TOGGLE BUTTON ================= -->

                    <button id="toggleBtn"
                            class="btn border-0 bg-transparent">

                        <i class="bi bi-list fs-2 text-white"></i>

                    </button>

                    <!-- ================= PAGE TITLE ================= -->

                    <h4 class="fw-bold text-success m-0">

                        PAGE & POUR POS

                    </h4>

                    <!-- ================= RIGHT SIDE ================= -->

                    <div class="ms-auto d-flex align-items-center">

                        <!-- ================= DATE & TIME ================= -->

                        <span id="dateTime"
                              class="me-4 text-secondary fw-semibold">

                        </span>

                        <!-- ================= CURRENT USER (temporary —
                        replaced by Login later) ================= -->

                        @{
                            var activeUsers = DbContext.Users
                                .Where(u => u.Status == "Active")
                                .OrderBy(u => u.FullName)
                                .ToList();

                            int? currentUserId = CurrentUserService.UserID;

                            string currentUserName =
                                CurrentUserService.FullName ?? "No Active User";

                            string currentUserRole =
                                CurrentUserService.Role ?? "-";
                        }

                        <div class="dropdown">

                            <button class="btn bg-transparent border-0 dflex align-items-center dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <i class="bi bi-person-circle fs-3 textsuccess"></i>

                                <span class="ms-2 fw-semibold text-start">

                                    @currentUserName
                                    <br />

                                    <small class="textmuted">
                                        @currentUserRole
                                    </small>

                                </span>

                            </button>

                            <ul class="dropdown-menu dropdown-menu-end">

                                @foreach (var u in activeUsers)
                                {
                                    <li>

                                        <form asp-controller="CurrentUser"
                                              asp-action="Switch"
                                              method="post"
                                              class="px-1">

                                            <input type="hidden"
                                                   name="userId"
                                                   value="@u.UserID" />

                                            <input type="hidden"
                                                   name="returnUrl"
                                                   value="@Context.Request.Path" />

                                            <button type="submit"
                                                    class="dropdown-item
                                                    @(u.UserID == currentUserId ? "active" : "")">

                                                @u.FullName — @u.Role

                                            </button>

                                        </form>

                                    </li>
                                }

                            </ul>

                        </div>

                    </div>

                </div>

            </nav>

            <!-- ================= PAGE CONTENT ================= -->

            <main class="container-fluid p-4">

                @RenderBody()

            </main>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- JAVASCRIPT -->
    <!-- ===================================================== -->

    <!-- jQuery -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Bootstrap -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Site JS -->

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <!-- Chart.js -->

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- ===================================================== -->
    <!-- SIDEBAR TOGGLE -->
    <!-- ===================================================== -->

    <script>

        // ===========================
        // SIDEBAR
        // ===========================

        const sidebar =
            document.getElementById("sidebar");

        const toggleBtn =
            document.getElementById("toggleBtn");

        // ===========================
        // RESTORE SIDEBAR STATE
        // ===========================

        if (
            localStorage.getItem("sidebarCollapsed")
            === "true"
        ) {

            sidebar.classList.add("collapsed");

        }

        // ===========================
        // TOGGLE SIDEBAR
        // ===========================

        toggleBtn.addEventListener(
            "click",
            function () {

                sidebar.classList.toggle("collapsed");

                // ===========================
                // SAVE SIDEBAR STATE
                // ===========================

                if (
                    sidebar.classList.contains("collapsed")
                ) {

                    localStorage.setItem(
                        "sidebarCollapsed",
                        "true"
                    );

                }
                else {

                    localStorage.setItem(
                        "sidebarCollapsed",
                        "false"
                    );

                }

            }
        );

        // =====================================================
        // DATE & TIME
        // =====================================================

        function updateDateTime() {

            const now = new Date();

            const options = {

                weekday: "long",

                year: "numeric",

                month: "long",

                day: "numeric",

                hour: "numeric",

                minute: "2-digit",

                second: "2-digit"

            };

            const dateTime =
                document.getElementById("dateTime");

            if (dateTime) {

                dateTime.innerHTML =
                    now.toLocaleString(
                        "en-US",
                        options
                    );

            }

        }

        // Run immediately

        updateDateTime();

        // Update every second

        setInterval(
            updateDateTime,
            1000
        );

    </script>

    <!-- ===================================================== -->
    <!-- PAGE-SPECIFIC SCRIPTS -->
    <!-- ===================================================== -->

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>