@model IEnumerable<LOSTBOOKS.Models.Service>

@{
    ViewData["Title"] = "Index";
}
<h1>Service Management</h1>
<br />

<form asp-action="Create" method="post">
    Service Type:
    <p>
        <label>
            <input type="radio" name="ServiceType" value="Rush" required />
            Rush
        </label>

        <label style="margin-left: 20px;">
            <input type="radio" name="ServiceType" value="Regular" required />
            Regular
        </label>
    </p>

    <p>
        Size:
        <input type="text" name="Size" required />
    </p>

    <p>
        Number of Pages:
        <input type="number" name="NumberOfPages" required />
    </p>

    <p>
        Cover Finish:
        <input type="text" name="CoverFinish" required />
    </p>

    <p>
        Price:
        <input type="number" step="0.01" name="Price" required />

        <button type="submit"
                style="background-color: blue; color: white; border: none; padding: 5px 15px; cursor: pointer;">
            ADD
        </button>
    </p>
</form>

<br />
<hr />
<br />

<form asp-action="Index" method="get" style="margin-bottom: 20px;">
    <input type="text" name="searchString" placeholder="Search services..." />
    <button type="submit">Search</button>
</form>

<table border="1" cellpadding="10" style="width:100%; border-collapse: collapse;">
    <thead>
        <tr style="background-color: #f2f2f2;">
            <th>ID</th>
            <th>Service Type</th>
            <th>Size</th>
            <th>Pages</th>
            <th>Cover Finish</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ServiceID</td>
                <td>@item.ServiceType</td>
                <td>@item.Size</td>
                <td>@item.NumberOfPages</td>
                <td>@item.CoverFinish</td>
                <td>₱@item.Price</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.ServiceID"
                       style="background-color: green; color: white; border: none; padding: 5px 15px; text-decoration: none;">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.ServiceID"
                       style="background-color: red; color: white; border: none; padding: 5px 15px; text-decoration: none;">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>